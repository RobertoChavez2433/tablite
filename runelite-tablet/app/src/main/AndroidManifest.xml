<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.x11" />
    </queries>

    <application
        android:name=".RuneLiteTabletApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.RuneLiteTablet"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Safety net: capture jagex: protocol redirects if Chrome somehow opens instead of GeckoView -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jagex" />
            </intent-filter>
        </activity>

        <!-- GeckoView-based OAuth authentication Activity -->
        <activity
            android:name=".auth.GeckoAuthActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.DirectSurfaceProbeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- S82 task #26 — Surface-AIDL handoff de-risker. Activity hosts a
             SurfaceView and ships its Surface to SurfaceRendererService over
             Binder/AIDL. Service runs in `:surfacerenderer` so the Surface
             really crosses a process boundary. exported=true so we can launch
             via `adb shell am start -n com.runelitetablet/.probe.surfaceaidl.SurfaceAidlProbeActivity`. -->
        <activity
            android:name=".probe.surfaceaidl.SurfaceAidlProbeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <service
            android:name=".probe.surfaceaidl.SurfaceRendererService"
            android:process=":surfacerenderer"
            android:exported="false" />

        <activity
            android:name=".presentation.hybrid.HybridX11HostActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Direct-Android-surface host: bypasses LorieView/X11/virgl entirely.
             rlawt JVM (built with -DRLAWT_DIRECT_SURFACE) connects to this
             activity's worker over abstract UDS, gets an AHB pool, blits
             frames straight to this SurfaceView. exported=true for adb
             validation; switches to the standard launch path once stable. -->
        <activity
            android:name=".directsurface.DirectSurfaceHostActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <service
            android:name=".termux.TermuxResultService"
            android:exported="false" />

        <service
            android:name=".session.RuneLiteSessionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Managing RuneLite game session processes in Termux" />
        </service>

        <receiver
            android:name=".installer.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".presentation.hybrid.TermuxX11StartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.termux.x11.CmdEntryPoint.ACTION_START" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".presentation.hybrid.HybridX11TestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.runelitetablet.action.OPEN_HYBRID_X11_HOST" />
                <action android:name="com.runelitetablet.action.START_HYBRID_X11_TEST" />
                <action android:name="com.runelitetablet.action.STOP_HYBRID_X11_TEST" />
                <action android:name="com.runelitetablet.action.PROBE_HYBRID_X11_FDS" />
                <action android:name="com.runelitetablet.action.RUN_HYBRID_X11_CLIENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
