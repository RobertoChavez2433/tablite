+static bool
+rlt_vtest_active_frame(struct rlt_vtest_telemetry_state *telemetry,
+                       uint64_t *producer_seq,
+                       uint64_t *producer_begin_ns)
+{
+   uint64_t before_seq;
+   uint64_t after_seq;
+
+   *producer_seq = 0;
+   *producer_begin_ns = 0;
+   if (!telemetry->enabled || !telemetry->page)
+      return false;
+   if (telemetry->page->magic != RLT_FRAME_TELEMETRY_MAGIC ||
+       telemetry->page->abi_version != RLT_FRAME_TELEMETRY_ABI_VERSION ||
+       telemetry->page->struct_size != RLT_FRAME_TELEMETRY_SIZE)
+      return false;
+
+   before_seq = atomic_load_explicit(
+      &telemetry->page->active_producer_seq, memory_order_acquire);
+   *producer_begin_ns = atomic_load_explicit(
+      &telemetry->page->active_begin_monotonic_ns, memory_order_acquire);
+   after_seq = atomic_load_explicit(
+      &telemetry->page->active_producer_seq, memory_order_acquire);
+   if (!before_seq || before_seq != after_seq || !*producer_begin_ns) {
+      *producer_begin_ns = 0;
+      return false;
+   }
+
+   *producer_seq = before_seq;
+   return true;
+}
+
+static void
+rlt_vtest_send_active_frame_marker(struct virgl_vtest_winsys *vtws)
+{
+   struct rlt_vtest_telemetry_state *telemetry = &vtws->rlt_telemetry;
+   uint64_t producer_seq;
+   uint64_t producer_begin_ns;
+   uint64_t wall_started_ns = 0;
+   uint64_t cpu_started_ns = 0;
+   uint64_t wall_ended_ns;
+   uint64_t cpu_ended_ns;
+   int result;
+
+   if (!rlt_vtest_active_frame(telemetry, &producer_seq,
+                               &producer_begin_ns)) {
+      if (telemetry->enabled)
+         telemetry->unattributed_events++;
+      return;
+   }
+
+   if (telemetry->self_profile_enabled) {
+      wall_started_ns = rlt_vtest_now_ns();
+      cpu_started_ns = rlt_vtest_thread_cpu_ns();
+   }
+   result = virgl_vtest_send_frame_marker(vtws, producer_seq,
+                                          producer_begin_ns);
+   telemetry->frame_marker_calls++;
+   if (result == 0) {
+      telemetry->frame_marker_bytes +=
+         (VTEST_HDR_SIZE + VCMD_RLT_FRAME_MARKER_SIZE) * sizeof(uint32_t);
+   }
+   if (wall_started_ns) {
+      wall_ended_ns = rlt_vtest_now_ns();
+      cpu_ended_ns = rlt_vtest_thread_cpu_ns();
+      telemetry->self_calls++;
+      if (wall_ended_ns >= wall_started_ns) {
+         telemetry->frame_marker_wall_ns +=
+            wall_ended_ns - wall_started_ns;
+         telemetry->self_wall_ns += wall_ended_ns - wall_started_ns;
+      }
+      if (cpu_started_ns && cpu_ended_ns >= cpu_started_ns) {
+         telemetry->frame_marker_thread_cpu_ns +=
+            cpu_ended_ns - cpu_started_ns;
+         telemetry->self_thread_cpu_ns += cpu_ended_ns - cpu_started_ns;
+      }
+   }
+   if (result != 0)
+      telemetry->unattributed_events++;
+}
