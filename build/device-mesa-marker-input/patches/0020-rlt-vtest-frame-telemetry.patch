+   telemetry->frame_count = 0;
+   telemetry->first_seq = 0;
+   telemetry->last_seq = 0;
+   telemetry->attributed_events = 0;
+   telemetry->unattributed_events = 0;
+   telemetry->incomplete_frames = 0;
+   telemetry->self_calls = 0;
+   telemetry->self_wall_ns = 0;
+   telemetry->self_thread_cpu_ns = 0;
+}
