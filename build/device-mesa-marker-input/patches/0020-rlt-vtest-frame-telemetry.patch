+      (unsigned long long)stats[RLT_VTEST_DISPLAY].p50_us,
+      (unsigned long long)stats[RLT_VTEST_DISPLAY].p95_us,
+      (unsigned long long)stats[RLT_VTEST_DISPLAY].max_us,
+      (unsigned long long)telemetry->stage_calls[RLT_VTEST_FENCE_WAIT],
+      (unsigned long long)stats[RLT_VTEST_FENCE_WAIT].mean_us,
+      (unsigned long long)stats[RLT_VTEST_FENCE_WAIT].p50_us,
