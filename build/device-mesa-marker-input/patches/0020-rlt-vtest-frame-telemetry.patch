+      (unsigned long long)stats[RLT_VTEST_TRANSFER_GET].max_us,
+      (unsigned long long)telemetry->stage_calls[RLT_VTEST_COMPLETION_WAIT],
+      (unsigned long long)stats[RLT_VTEST_COMPLETION_WAIT].mean_us,
+      (unsigned long long)stats[RLT_VTEST_COMPLETION_WAIT].p50_us,
+      (unsigned long long)stats[RLT_VTEST_COMPLETION_WAIT].p95_us,
