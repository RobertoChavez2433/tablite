+static uint64_t
+rlt_vtest_active_seq(struct rlt_vtest_telemetry_state *telemetry)
+{
+   if (!telemetry->enabled || !telemetry->page)
+      return 0;
+   if (telemetry->page->magic != RLT_FRAME_TELEMETRY_MAGIC ||
+       telemetry->page->abi_version != RLT_FRAME_TELEMETRY_ABI_VERSION ||
+       telemetry->page->struct_size != RLT_FRAME_TELEMETRY_SIZE)
+      return 0;
+   return atomic_load_explicit(
+      &telemetry->page->active_producer_seq, memory_order_acquire);
+}
+
+static struct rlt_vtest_span
+rlt_vtest_span_begin(struct virgl_vtest_winsys *vtws)
+{
+   struct rlt_vtest_telemetry_state *telemetry = &vtws->rlt_telemetry;
+   const uint64_t self_wall_started_ns = telemetry->self_profile_enabled
+      ? rlt_vtest_now_ns() : 0;
+   const uint64_t self_cpu_started_ns = telemetry->self_profile_enabled
+      ? rlt_vtest_thread_cpu_ns() : 0;
+   struct rlt_vtest_span span = {0};
+   span.producer_seq = rlt_vtest_active_seq(telemetry);
+   if (span.producer_seq)
+      span.started_ns = rlt_vtest_now_ns();
+   else if (telemetry->enabled)
+      telemetry->unattributed_events++;
+   rlt_vtest_self_end(telemetry, self_wall_started_ns, self_cpu_started_ns);
+   return span;
+}
+
+static void
+rlt_vtest_span_end(struct virgl_vtest_winsys *vtws,
+                   enum rlt_vtest_stage stage,
+                   struct rlt_vtest_span span,
+                   uint64_t bytes)
+{
+   struct rlt_vtest_telemetry_state *telemetry = &vtws->rlt_telemetry;
+   const uint64_t self_wall_started_ns = telemetry->self_profile_enabled
+      ? rlt_vtest_now_ns() : 0;
+   const uint64_t self_cpu_started_ns = telemetry->self_profile_enabled
+      ? rlt_vtest_thread_cpu_ns() : 0;
+   if (!span.producer_seq)
+      goto out;
+   if (rlt_vtest_active_seq(telemetry) != span.producer_seq) {
+      telemetry->unattributed_events++;
+      goto out;
+   }
+   if (telemetry->current_seq && telemetry->current_seq != span.producer_seq) {
+      telemetry->incomplete_frames++;
+      memset(telemetry->current_stage_ns, 0, sizeof(telemetry->current_stage_ns));
+   }
+   telemetry->current_seq = span.producer_seq;
+   telemetry->current_stage_ns[stage] += rlt_vtest_now_ns() - span.started_ns;
+   telemetry->stage_calls[stage]++;
+   telemetry->stage_bytes[stage] += bytes;
+   telemetry->attributed_events++;
+out:
+   rlt_vtest_self_end(telemetry, self_wall_started_ns, self_cpu_started_ns);
+}
+
+static void
+rlt_vtest_complete_frame(struct virgl_vtest_winsys *vtws)
+{
+   struct rlt_vtest_telemetry_state *telemetry = &vtws->rlt_telemetry;
+   const uint64_t self_wall_started_ns = telemetry->self_profile_enabled
+      ? rlt_vtest_now_ns() : 0;
+   const uint64_t self_cpu_started_ns = telemetry->self_profile_enabled
+      ? rlt_vtest_thread_cpu_ns() : 0;
+   const uint64_t active_seq = rlt_vtest_active_seq(telemetry);
+   if (!active_seq || active_seq != telemetry->current_seq) {
+      rlt_vtest_self_end(telemetry, self_wall_started_ns, self_cpu_started_ns);
+      return;
+   }
+
+   const unsigned slot = telemetry->frame_count;
+   for (unsigned stage = 0; stage < RLT_VTEST_STAGE_COUNT; stage++)
+      telemetry->frame_samples_ns[stage][slot] = telemetry->current_stage_ns[stage];
+   if (!telemetry->first_seq)
+      telemetry->first_seq = active_seq;
+   telemetry->last_seq = active_seq;
+   telemetry->frame_count++;
+   telemetry->current_seq = 0;
+   memset(telemetry->current_stage_ns, 0, sizeof(telemetry->current_stage_ns));
+
+   if (telemetry->frame_count == RLT_VTEST_WINDOW_FRAMES)
+      rlt_vtest_emit_window(telemetry);
+   rlt_vtest_self_end(telemetry, self_wall_started_ns, self_cpu_started_ns);
+}
+
+static void
+rlt_vtest_telemetry_init(struct virgl_vtest_winsys *vtws)
+{
+   struct rlt_vtest_telemetry_state *telemetry = &vtws->rlt_telemetry;
+   telemetry->fd = -1;
+   const char *path = getenv("RLT_VTEST_TELEMETRY_PATH");
+   const char *self_profile = getenv("RLT_TELEMETRY_SELF_PROFILE");
+   telemetry->self_profile_enabled = self_profile && *self_profile &&
+      !(self_profile[0] == '0' && self_profile[1] == '\0');
+   if (!path || !*path)
+      return;
+
+   telemetry->fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (telemetry->fd < 0)
+      return;
+   struct stat st;
+   if (fstat(telemetry->fd, &st) != 0 ||
+       st.st_size < (off_t)RLT_FRAME_TELEMETRY_SIZE)
+      goto fail;
+
+   telemetry->page = mmap(NULL, RLT_FRAME_TELEMETRY_SIZE, PROT_READ,
+                          MAP_SHARED, telemetry->fd, 0);
+   if (telemetry->page == MAP_FAILED) {
+      telemetry->page = NULL;
+      goto fail;
+   }
+   telemetry->enabled = true;
+   return;
+
+fail:
+   close(telemetry->fd);
+   telemetry->fd = -1;
+}
+
+static void
+rlt_vtest_telemetry_destroy(struct rlt_vtest_telemetry_state *telemetry)
+{
+   if (telemetry->page)
+      munmap((void *)telemetry->page, RLT_FRAME_TELEMETRY_SIZE);
+   if (telemetry->fd >= 0)
+      close(telemetry->fd);
+}
