+static uint64_t
+rlt_vtest_now_ns(void)
+{
+   struct timespec now;
+   clock_gettime(CLOCK_MONOTONIC, &now);
+   return (uint64_t)now.tv_sec * 1000000000ULL + (uint64_t)now.tv_nsec;
+}
+
+static uint64_t
+rlt_vtest_thread_cpu_ns(void)
+{
+   struct timespec now;
+   if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &now) != 0)
+      return 0;
+   return (uint64_t)now.tv_sec * 1000000000ULL + (uint64_t)now.tv_nsec;
+}
+
+static void
+rlt_vtest_self_end(struct rlt_vtest_telemetry_state *telemetry,
+                   uint64_t wall_started_ns,
+                   uint64_t cpu_started_ns)
+{
+   uint64_t wall_ended_ns;
+   uint64_t cpu_ended_ns;
+
+   if (!wall_started_ns)
+      return;
+   wall_ended_ns = rlt_vtest_now_ns();
+   cpu_ended_ns = rlt_vtest_thread_cpu_ns();
+   telemetry->self_calls++;
+   if (wall_ended_ns >= wall_started_ns)
+      telemetry->self_wall_ns += wall_ended_ns - wall_started_ns;
+   if (cpu_started_ns && cpu_ended_ns >= cpu_started_ns)
+      telemetry->self_thread_cpu_ns += cpu_ended_ns - cpu_started_ns;
+}
+
+static int
+rlt_vtest_cmp_u64(const void *left, const void *right)
+{
+   const uint64_t a = *(const uint64_t *)left;
+   const uint64_t b = *(const uint64_t *)right;
+   return a < b ? -1 : a > b ? 1 : 0;
+}
+
+static struct rlt_vtest_stats
+rlt_vtest_compute_stats(const uint64_t *samples, unsigned count)
+{
+   uint64_t scratch[RLT_VTEST_WINDOW_FRAMES];
+   uint64_t sum = 0;
+   struct rlt_vtest_stats result = {0};
+
+   for (unsigned i = 0; i < count; i++) {
+      scratch[i] = samples[i];
+      sum += samples[i];
+   }
+   if (!count)
+      return result;
+
+   qsort(scratch, count, sizeof(scratch[0]), rlt_vtest_cmp_u64);
+   const unsigned p95_index = ((count * 95U + 99U) / 100U) - 1U;
+   result.mean_us = (sum / count) / 1000ULL;
+   result.p50_us = scratch[count / 2U] / 1000ULL;
+   result.p95_us = scratch[p95_index] / 1000ULL;
+   result.max_us = scratch[count - 1U] / 1000ULL;
+   return result;
+}
+
+static const char *
+rlt_vtest_run_id(void)
+{
+   const char *run_id = getenv("RLT_CAPTURE_ID");
+   if (!run_id || !*run_id)
+      return "unknown";
+   for (const char *cursor = run_id; *cursor; cursor++) {
+      if ((size_t)(cursor - run_id) >= 64 ||
+          !(isalnum((unsigned char)*cursor) || *cursor == '-' ||
+            *cursor == '_' || *cursor == '.'))
+         return "invalid";
+   }
+   return run_id;
+}
